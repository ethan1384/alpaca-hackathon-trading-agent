ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
# test | iex | sip — options data needs a live feed (iex or sip); the test feed has no options
ALPACA_DATA_FEED=test
MARKET_BUFFER_SIZE=200
# The L2 order book (SymbolDetailDialog) is crypto-only and 24/7. To see it, use a
# crypto watchlist with a real feed, e.g. ALPACA_DATA_FEED=iex and:
#   NEXT_PUBLIC_DEFAULT_SYMBOLS=BTC/USD,ETH/USD
# A single Alpaca stream cannot mix stock and crypto symbols.
NEXT_PUBLIC_DEFAULT_SYMBOLS=AAPL,TSLA,SPY
# Optional. When set, /api/mcp requires `Authorization: Bearer <token>`.
# Leave empty for unauthenticated local paper-trading access.
MCP_AUTH_TOKEN=

# --- Hackathon competition guardrails (docs/05-hackathon-rules.md) ---
# true  -> guardrails throw: no opening trades outside the scored window, no
#          option legs expiring past the judged snapshot (EOD Thu 2026-09-03).
# false -> guardrails only warn. Use this for development and backtests.
# The official run sets this to true.
COMPETITION_ENFORCE=false
# Account number of the official $100k competition paper account. When set, the
# app refuses to trade any other account — a stale .env cannot corrupt the
# measured P&L. Leave empty while developing against the testing account.
COMPETITION_ACCOUNT_NUMBER=

# --- Portfolio & operational risk layer (docs/06-options-parameters.md) ---
# true  -> the risk gate runs before every opening order and throws on a breach:
#          kill switch [O1], data circuit breaker [O2], execution-time window
#          [O3], and the portfolio caps [K1]-[K6].
# false -> the gate is skipped entirely (no account or chain lookups), so tests
#          and backtests run without credentials. The official run sets true.
RISK_ENFORCE=false
# Where the structured decision log [O5] (decisions.jsonl) and the agent
# working-memory file (agent-state.json) live. Everything that places, closes or
# cancels an order — the LLM agent, the MCP tools, the REST routes — appends a
# record here. On an ephemeral / serverless host this directory does NOT survive
# a redeploy and is not shared across instances: for the official run, point it
# at a persistent volume so the audit trail is complete after the fact.
AGENT_LOG_DIR=.agent
# filesystem (local dev) | blob (Vercel — requires BLOB_READ_WRITE_TOKEN from Storage → Blob)
AGENT_STORAGE=filesystem
# Injected automatically when a Vercel Blob store is linked to the project.
# BLOB_READ_WRITE_TOKEN=

# --- LLM decision agent (docs/08-agent.md) ---
# OpenAI-compatible chat/completions endpoint. Local Ollama by default; swap in
# Featherless (https://api.featherless.ai/v1) or any compatible host, no code change.
AGENT_LLM_BASE_URL=http://localhost:11434/v1
# Local Ollama: qwen3:8b. Featherless (remote): Qwen/Qwen2.5-14B-Instruct (instruct, not reasoning).
AGENT_LLM_MODEL=qwen3:8b
# Bearer token for the endpoint. Leave empty for a local Ollama.
AGENT_LLM_API_KEY=
# Ollama reasoning models (qwen3): use 4096. Remote instruct models: 1024 is enough.
AGENT_LLM_MAX_TOKENS=4096
# Remote (Featherless): 60000. Local Ollama reasoning: up to 120000.
AGENT_LLM_TIMEOUT_MS=120000
# Hard on/off for POST /api/agent/run. false -> the route returns 503.
AGENT_ENABLED=true
# DEV ONLY. Simulated clock for the agent cycle, so the entry path can be tested
# before the scoring window opens. Ignored when COMPETITION_ENFORCE=true.
# Pick an instant inside the scoring window AND the 10:00-11:00 ET entry window.
# AGENT_CLOCK_OVERRIDE=2026-09-02T14:30:00Z
